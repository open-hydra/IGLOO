# Building file
CMakePresets.json
build

# Fortran module files
mod
*.mod

# Executables
bin
*.exe

# Test output files
error*
OUTPUT
# Parked sweep OUTPUT dirs. The shipped harness no longer parks (it relies on the production
# -sweep<N> filename suffix, inside OUTPUT/, already covered above) -- but a hand-run of an older
# twosweep, or any manual A/B, drops these. Glob, not `.sweep1`: an exact rule let 6.7 MB of
# generated source.tec into the P6 commit (since stripped) -- the gas-cycle mode writes .sweep2.
OUTPUT.sweep*
# datum-abs runs its relative sibling into ref-rel/ (tests/evaporation/datum-abs/check.py)
ref-rel
# boiling-temperature-key runs its Tboil sibling into ref-tboil/ (tests/evaporation/boiling-temperature-key/check.py)
ref-tboil
# no-psat runs its psat sibling into ref-psat/ (tests/evaporation/no-psat/check.py)
ref-psat
# two-fam-bc-2blk runs its one-block sibling into ref-1blk/ (tests/infrastructure/two-fam-bc-2blk/check.py)
ref-1blk
# two-fam-bc-2blk-mollify also runs it unsmoothed into ref-1blk-raw/ (tests/infrastructure/two-fam-bc-2blk-mollify/check.py)
ref-1blk-raw
# conn-103 runs its 400 sibling into ref-400/ (tests/infrastructure/conn-103/check.py)
ref-400
# wall-flux runs its deck without [IGLOO-Erosion] into ref-noerosion/ (tests/erosion/wall-flux/check.py)
ref-noerosion
# wall-laws runs its deck with n1, n2, k2 as values into ref-direct/ (tests/erosion/wall-laws/check.py)
ref-direct
# out-dcell3, out-off and rad-foreign-key run the plain drag-stokes case into ref-plain/ (their check.py);
# foreign-keys and foreign-keys-db run their deck cut at [decoys] there, zero-group-line the plain drag-stokes case
ref-plain
# body-evap-m2, body-evap-m4 and body-burn-m5 run their out-file = S layout into ref-S/ (tests/tools/body_source_check.py)
ref-S
# mhb98-water-blowing runs the droplet without blowing into ref-noblow/ (tests/evaporation/mhb98-water-blowing/check.py)
ref-noblow
# periodic-y and periodic-2d run unsmoothed, first-row and print-ds siblings (tests/infrastructure/periodic-y/check.py),
# vortex-cloud-st1 and swirl-wedge their print-ds siblings
ref-raw
ref-row
ref-row-raw
ref-ds
# chimera-2blk-shift-mollify runs the box shifted by half a cell into ref-shift/ and ref-shift-raw/ (its check.py)
ref-shift
ref-shift-raw
# chimera-2blk-shift3 runs the box shifted by 0.3 of a cell into ref-shift3/ and ref-shift3-ord2/, itself at gas
# order 2 into ref-ord2/ (its check.py)
ref-shift3
ref-shift3-ord2
# etab-e2e-dopri5 runs its H-sdirk4 sibling into ref-sdirk4/ (tests/breakup/etab-e2e-dopri5/check.py)
ref-sdirk4
# out-exit-row runs its gas-order and cadence siblings into ref-o1-*/ and ref-o2-*/ (tests/standard/out-exit-row/check.py)
ref-o1-*
ref-o2-*
# the replay of the parcel rule (tests/tools/replay.py) reads a sibling that writes every segment end, in ref-ends/
ref-ends
# the last row at a stop (tests/tools/lastrow.py) is read from a sibling without row keys, in ref-last/
ref-last
# mpi/two-fam-bc-2blk-ord2-dual-np3 runs the same binary on one rank into ref-serial/ (its check.py)
ref-serial
# breakup-per-material reruns its case once per material into ref-A/ .. ref-D/ (tests/breakup/breakup-per-material/check.py)
ref-[ABCD]
# burn-box-residue runs its d-residue and fail-after siblings into ref-dres/ and ref-fail/ (tests/combustion/burn-box-residue/check.py)
ref-dres
ref-fail
# solver-fail-refine runs its body-force sibling into ref-g/ (tests/infrastructure/solver-fail-refine/check.py)
ref-g
# inner-loop-cap runs its evaporating sibling into ref-consumed/ (tests/infrastructure/inner-loop-cap/check.py)
ref-consumed
# tab-wedge-slip runs its gas-order-2 control into ref-ord2/ (tests/breakup/tab-wedge-slip/check.py)
ref-ord2
# burnout-ord2-slab runs its default mass-tol sibling into ref-burnout/ (tests/evaporation/burnout-ord2-slab/check.py)
ref-burnout
# Verification build tree lives INSIDE build/ (build/verif), so the `build` rule above
# already covers it; build_*/ stays as a guard against stray out-of-tree variants.
build_*/
# Unit-test CSV reports: written relative to the caller's cwd, so a test executable run
# by hand outside the build tree drops one wherever you happen to be.
verif_*.csv

# What tests/bench/monolith/sync-src-monolith.sh shipped (commits and dirty counts), written at each sync
IGLOO-commit.txt

# Test-case scratch artifacts (debug/gate runs)
test/*/dbg*
test/*/_reg_*
test/*/run[0-9]*
test/*/run_std*
test/*/preA_*
test/*/postB_*
test/*/err_gate
test/*/b_err.txt
test/*/prog_err.txt
test/*/smoke_*
test/*/time_refac.txt
test/*/out.txt
test/*_results.txt

# e2e case run logs
tests/*/*/run_*.txt
tests/*/*/err_*.txt
# refusal cases sit one level deeper and also record the exit code
tests/*/*/*/run_*.txt
tests/*/*/*/rc.txt
# Failure-only diagnostics written by check_threads.py (BUGS.md O13). Absent on a passing run.
tests/*/*/diag_*.txt
# Per-rank-count .tec snapshots kept by the mpi-consistency gate for its cross-rank compare
tests/mpi/*/tec_n*/
# Per-thread-count runs of the thread gates (tests/tools/check_threads_case.py)
tests/*/*/threads-omp*/
# The window gate's runs (tests/tools/check_window_case.py)
tests/*/*/window-*/

# mkdocs build output
site/
__pycache__/

# Paper draft (kept out of the repo)
open_hydra_1_0/

# Source PDFs of the cited papers (publisher copyright) + digitized CSVs; REFERENCES.md
# records DOI + provenance instead. Local-only working copies.
papers/

# Plan/design scratch bucket: local working notes, not shipped.
plan-bucket/

# Working notes, not deliverables: the bug ledger and the narrative findings log are
# how we track the V&V effort between sessions, not documentation for users. Kept on
# disk, out of the repo. Nothing in the tree cites them any more -- the facts they
# carried were inlined at each site, so neither is structural.
tests/BUGS.md
tests/FINDINGS.md

# Assistant guidance, not project documentation (was in .git/info/exclude; here so the
# rule is shared rather than per-clone).
CLAUDE.md

# Claude Code working files (local only)
.claude/
.claude-context/
